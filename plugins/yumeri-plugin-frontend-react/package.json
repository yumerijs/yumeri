{
  "name": "yumeri-plugin-frontend-react",
  "version": "1.0.0",
  "description": "React frontend framework service for Yumeri",
  "main": "dist/index.js",
  "dev": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "frontend",
    "static"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p frontend/tsconfig.json --noEmit && vite build"
